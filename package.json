{
  "name": "ch-cajero-android",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Cajero offline para CH Electronic / Componentes Habana",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "test:phase1": "node --test tests/barcode-buffer.test.js tests/cart.test.js",
    "test:phase2": "node --test tests/money.test.js tests/sale-rules.test.js",
    "test:all": "node --test tests/*.test.js",
    "test:phase3": "node --test tests/catalog-import.test.js tests/backup-validation.test.js tests/closure.test.js",
    "verify:phase3": "bash scripts/verify-phase3.sh",
    "verify:phase4": "bash scripts/verify-phase4.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.0.0"
  }
}
